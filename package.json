{
  "name": "tpirs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yaml,yml}\"",
    "prepare": "husky",
    "setup": "node scripts/setup.mjs",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:migrate": "pnpm --filter @tpirs/db migrate up",
    "db:migrate:down": "pnpm --filter @tpirs/db migrate down",
    "db:check": "pnpm --filter @tpirs/db migrate check",
    "db:seed": "pnpm --filter @tpirs/db seed",
    "ci:verify": "sh scripts/ci/verify.sh",
    "ci:migration-check": "sh scripts/ci/migration-check.sh",
    "ci:deploy": "sh scripts/ci/deploy.sh",
    "smoke": "sh scripts/ci/smoke.sh"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
