# Environment configuration for local development and CI.
# Copy to .env (the setup script does this automatically). Never commit .env.

# --- Database (matches infra/docker-compose.yml Postgres service) ---
DATABASE_URL=postgres://tpirs:tpirs@localhost:5433/tpirs
# Used only by integration tests (RLS, auth, audit). Left unset, DB-backed
# tests skip so unit runs need no database. CI points this at a scratch DB.
TEST_DATABASE_URL=postgres://tpirs:tpirs@localhost:5433/tpirs

# --- Redis (matches the compose Redis service) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (S3-compatible) ---
# Selected adapter: "s3" for S3-compatible stores, "localdisk" for the
# filesystem fallback (unit tests / developers without a store), or "mock" for
# a hosted pilot that has not provisioned a bucket (uploads are process-local
# and disappear when the instance recycles). See docs/adr/0005-local-object-store.md.
OBJECT_STORAGE_ADAPTER=s3
# Local/CI store is SeaweedFS (matches the compose object-store service).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tpirs-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=tpirs
OBJECT_STORAGE_SECRET_ACCESS_KEY=tpirs-secret
# Only used when OBJECT_STORAGE_ADAPTER=localdisk.
OBJECT_STORAGE_LOCAL_DIR=.docker-data/object-storage

# --- API service ---
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Behind a reverse proxy (Vercel, Railway, nginx) trust X-Forwarded-For so
# per-IP throttling measures the visitor, not the proxy. Leave false locally.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API. Empty keeps the
# same-origin assumption (the dev proxy and a single-origin deployment need
# nothing here). A split-origin deployment lists every frontend origin, e.g.
# https://admin.example.vercel.app,https://field.example.vercel.app
CORS_ORIGINS=
# SameSite on the httpOnly refresh cookie. "strict" for same-origin; "none"
# (with Secure, so NODE_ENV=production) when the API is on another site.
REFRESH_COOKIE_SAMESITE=strict
# Shared secret for first-run tenant creation. Required before a deployment is
# reachable from the internet: in production an unset token disables setup.
# Open onboarding at https://<admin>/?setupToken=<value>.
SETUP_TOKEN=
# Base address of the public verification page, e.g. https://field.example.gov.
# When set, a printed sticker's QR encodes <base>/v/<token> so an ordinary phone
# camera opens a page; when empty, the QR carries the opaque token alone. The
# officer app accepts both. The page itself is not shipped yet (ADR 0067).
PUBLIC_VERIFY_BASE_URL=
# Postgres pool size per process. A serverless instance should use 1 and point
# DATABASE_URL at a transaction pooler (Supabase/Supavisor, PgBouncer).
DB_POOL_MAX=10
# When true, staff login requires a TOTP code. Off by default in local dev.
# The sign-in forms do not show a code field yet (v1 is password only), so
# turning this on locks every staff user out until that field returns.
REQUIRE_STAFF_TOTP=false
# Dev-only QR token signing key. Generate a real secret per deployment;
# never reuse this value outside local development.
SECRET_QR_TOKEN_SIGNING_KEY=dev-only-qr-signing-key-change-me
# Region/partition label stamped into logs and health output for a deployment.
DEPLOYMENT_REGION=local

# --- Telemetry (OpenTelemetry) ---
OTEL_SERVICE_NAME=tpirs
OTEL_EXPORTER_OTLP_ENDPOINT=
# Exposes GET /metrics in Prometheus text format (ADR 0042). Off by default; the
# endpoint is unauthenticated and must stay on the internal network only.
METRICS_ENABLED=false

# --- Testing / smoke ---
# When set, the noop deploy target records deployments to this file.
DEPLOY_TARGET=noop

# --- Dashboard handover links (apps/admin) ---
# Where the account handover card sends a new officer or collector. One
# deployment serves every tenant from the same three frontends, so these are
# deployment settings, not tenant config. The dashboard defaults to the origin
# serving it; an unset field/collector address is reported on the card as
# "not configured in this build" rather than linked — except under `pnpm dev`,
# where the three apps always run side by side and the address is derived from
# the dashboard's own host on ports 5174 (field) and 5175 (collector).
# VITE_ADMIN_APP_URL=https://levy.example.gov
# VITE_FIELD_APP_URL=https://officer.levy.example.gov
# VITE_COLLECTOR_APP_URL=https://collector.levy.example.gov

# --- Demo seed guard ---
# The demo seed writes accounts whose passwords are in the repository, so it
# refuses to run with NODE_ENV=production unless this is exactly "true"
# ("1", "yes" and anything else are not consent). Leave unset: `pnpm setup
# --seed` and `pnpm db:seed` target the local/CI database, never production.
ALLOW_DEMO_SEED=
