# Environment configuration for local development and CI.
# Copy to .env (the setup script does this automatically). Never commit .env.

# --- Database (matches infra/docker-compose.yml Postgres service) ---
DATABASE_URL=postgres://tpirs:tpirs@localhost:5433/tpirs
# Used only by integration tests (RLS, auth, audit). Left unset, DB-backed
# tests skip so unit runs need no database. CI points this at a scratch DB.
TEST_DATABASE_URL=postgres://tpirs:tpirs@localhost:5433/tpirs

# --- Redis (matches the compose Redis service) ---
REDIS_URL=redis://localhost:6380

# --- Object storage (S3-compatible) ---
# Selected adapter: "s3" for S3-compatible stores, "localdisk" for the
# filesystem fallback (unit tests / developers without a store). See
# docs/adr/0005-local-object-store.md.
OBJECT_STORAGE_ADAPTER=s3
# Local/CI store is SeaweedFS (matches the compose object-store service).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tpirs-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=tpirs
OBJECT_STORAGE_SECRET_ACCESS_KEY=tpirs-secret
# Only used when OBJECT_STORAGE_ADAPTER=localdisk.
OBJECT_STORAGE_LOCAL_DIR=.docker-data/object-storage

# --- API service ---
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# When true, staff login requires a TOTP code. Off by default in local dev.
REQUIRE_STAFF_TOTP=false
# Region/partition label stamped into logs and health output for a deployment.
DEPLOYMENT_REGION=local

# --- Telemetry (OpenTelemetry) ---
OTEL_SERVICE_NAME=tpirs
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Testing / smoke ---
# When set, the noop deploy target records deployments to this file.
DEPLOY_TARGET=noop
