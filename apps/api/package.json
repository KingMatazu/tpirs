{
  "name": "@tpirs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.5.2",
    "@tpirs/adapters-env-secrets": "workspace:*",
    "@tpirs/adapters-localdisk-storage": "workspace:*",
    "@tpirs/adapters-otel-telemetry": "workspace:*",
    "@tpirs/adapters-prometheus-telemetry": "workspace:*",
    "@tpirs/adapters-s3-storage": "workspace:*",
    "@tpirs/application": "workspace:*",
    "@tpirs/asset-schema-registry-config": "workspace:*",
    "@tpirs/cache-mock": "workspace:*",
    "@tpirs/channel-providers": "workspace:*",
    "@tpirs/clock-mock": "workspace:*",
    "@tpirs/config": "workspace:*",
    "@tpirs/crypto": "workspace:*",
    "@tpirs/db": "workspace:*",
    "@tpirs/domain": "workspace:*",
    "@tpirs/export-service-csv": "workspace:*",
    "@tpirs/export-service-pdf": "workspace:*",
    "@tpirs/export-service-xlsx": "workspace:*",
    "@tpirs/fee-engine-config": "workspace:*",
    "@tpirs/identity-provider-db": "workspace:*",
    "@tpirs/lock-service-mock": "workspace:*",
    "@tpirs/payment-provider-paystack": "workspace:*",
    "@tpirs/payment-provider-remita": "workspace:*",
    "@tpirs/ports": "workspace:*",
    "@tpirs/settlement-import-csv": "workspace:*",
    "@tpirs/sms-provider-mock": "workspace:*",
    "fastify": "^5.4.0",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@tpirs/object-storage-mock": "workspace:*",
    "@tpirs/payment-provider-mock": "workspace:*",
    "@tpirs/secrets-provider-mock": "workspace:*",
    "@tpirs/telemetry-mock": "workspace:*",
    "vitest": "^3.2.4"
  }
}
