import type { FastifyInstance } from "fastify";
import { InvalidQrTokenError, todayInTimeZone } from "@tpirs/domain";
import { AssetNotFoundError } from "@tpirs/application";
import type { TenantConfigLoader } from "@tpirs/application";
import { repositories, withTenant } from "@tpirs/db";
import { requirePermission } from "../auth.js";
import type { Services } from "../services.js";
import {
  createDisputeSchema,
  createScanSchema,
  getDisputeSchema,
  listDisputesSchema,
  listScansSchema,
  verificationSearchSchema,
  syncPaidSchema,
} from "../schemas.js";

function badRequest(request: any, message: string) {
  return {
    error: {
      code: "bad_request",
      message,
      requestId: String((request as any).id),
    },
  };
}

function notFound(request: any) {
  return {
    error: {
      code: "not_found",
      message: "Asset not found",
      requestId: String((request as any).id),
    },
  };
}

export function registerVerificationAndSyncRoutes(
  app: FastifyInstance,
  context: {
    readonly services: Services;
    readonly loadConfig: TenantConfigLoader;
    readonly db: import("@tpirs/db").AnyDb;
  },
): void {
  const { services, loadConfig, db } = context;

  (app as any).get("/v1/verifications/search", { schema: verificationSearchSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const rp: any = requirePermission as any;
    const principal: any = rp(request, "scan:read");
    const { q } = request.query as { q: string };
    const tenantId = principal.tenantId;
    const config = await loadConfig(tenantId);
    const businessDate = todayInTimeZone(config?.locale.timezone ?? "UTC", new Date());
    const results = await withTenant(db, tenantId, async (tx: any) => {
      const assets = await repositories(tx).assets.search(tenantId, { query: q, limit: 20 });
      const out: any[] = [];
      for (const asset of assets) {
        const period = await repositories(tx).obligations.findByAssetAndDate(tenantId, asset.id, businessDate);
        const { paymentStatusFromPeriod } = await import("@tpirs/domain");
        out.push({
          assetId: asset.id,
          assetTypeKey: asset.assetTypeKey,
          status: asset.status,
          shortCode: asset.shortCode,
          attributes: asset.attributes,
          paymentStatus: paymentStatusFromPeriod(period?.status ?? "none"),
          businessDate,
        });
      }
      return out;
    });
    return reply.send({ results });
    })();
  });

  (app as any).get("/v1/sync/paid", { schema: syncPaidSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "scan:read");
    const tenantId = principal.tenantId;
    const query = request.query as { since?: string; limit?: string };
    const limit = query.limit !== undefined ? Number(query.limit) : undefined;
    const syncArgs: any = {};
    if (query.since !== undefined) syncArgs.since = query.since;
    if (Number.isFinite(limit as number)) syncArgs.limit = limit as number;
    const result: any = await services.paidSetSync.sync(tenantId, syncArgs);
    if (result && typeof result === "object" && "error" in result) {
      if (result.error === "not_found") {
        const config = await loadConfig(tenantId);
        if (config?.featureFlags.offlineMode !== true) {
          return reply.code(403).send({ error: { code: "forbidden", message: "Offline mode disabled", requestId: String(request.id) } });
        }
        return reply.code(404).send({ error: { code: "not_found", message: "Not found", requestId: String(request.id) } });
      }
    }
    return reply.send(result);
    })();
  });

  (app as any).post("/v1/scans", { schema: createScanSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "scan:record");
    const body = request.body as any;
    if (!body?.clientScanId || String(body.clientScanId).trim() === "") {
      return reply.code(400).send(badRequest(request, "clientScanId required"));
    }
    if (!body?.scannedAt || String(body.scannedAt).trim() === "") {
      return reply.code(400).send(badRequest(request, "scannedAt required"));
    }
    const tenantId = principal.tenantId;
    const config = await loadConfig(tenantId);
    const businessDate = todayInTimeZone(config?.locale.timezone ?? "UTC", new Date());
    const scannedAt = new Date(body.scannedAt);
    if (Number.isNaN(scannedAt.getTime())) return reply.code(400).send(badRequest(request, "Invalid scannedAt"));

    let assetId = body.assetId;
    if ((!assetId || String(assetId).trim() === "") && body.token) {
      try {
        const verified = await services.asset.verifyQrToken(body.token);
        assetId = verified.asset.id;
      } catch (error) {
        if (error instanceof InvalidQrTokenError || error instanceof AssetNotFoundError) {
          return reply.code(404).send(notFound(request));
        }
        throw error;
      }
    }
    if (!assetId || String(assetId).trim() === "") {
      return reply.code(400).send(badRequest(request, "assetId or token required"));
    }

    let paymentStatus: "paid" | "no_payment_recorded" | "unknown" = "unknown";
    if (config !== undefined) {
      const period = await withTenant(db, tenantId, async (tx: any) =>
        repositories(tx).obligations.findByAssetAndDate(tenantId, assetId, businessDate),
      );
      const { paymentStatusFromPeriod } = await import("@tpirs/domain");
      paymentStatus = paymentStatusFromPeriod(period?.status ?? "none");
    }

    const row = await withTenant(db, tenantId, async (tx: any) =>
      repositories(tx).scans.insertIfAbsent({
        tenantId,
        assetId,
        officerUserId: (principal as any).userId ?? (principal as any).id,
        deviceId: ((principal as any).deviceId ?? "unknown") as string,
        clientScanId: body.clientScanId,
        source: body.source,
        observedStatus: body.observedStatus ?? paymentStatus,
        authoritativeStatus: paymentStatus,
        businessDate,
        scannedAt,
        latitude: body.latitude ?? null,
        longitude: body.longitude ?? null,
        zoneId: (principal as any).zoneId ?? null,
      }),
    );

    const asset = await withTenant(db, tenantId, async (tx: any) => repositories(tx).assets.findById(assetId));
    return reply.send({
      scanId: row?.id,
      assetId,
      businessDate,
      observedStatus: body.observedStatus ?? paymentStatus,
      authoritativeStatus: paymentStatus,
      paymentStatus,
      shortCode: asset?.shortCode,
      attributes: asset?.attributes,
    });
    })();
  });

  (app as any).get("/v1/scans", { schema: listScansSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "scan:read");
    const tenantId = principal.tenantId;
    const query = request.query as any;
    const limit = query.limit !== undefined ? Number(query.limit) : undefined;
    const listArgs: any = {
      cursor: query.cursor,
      limit: Number.isFinite(limit as number) ? (limit as number) : undefined,
    };
    if (query.officerUserId !== undefined) listArgs.officerUserId = query.officerUserId;
    const result = await withTenant(db, tenantId, async (tx: any) => repositories(tx).scans.list(tenantId, listArgs));
    return reply.send(result);
    })();
  });

  (app as any).post("/v1/disputes", { schema: createDisputeSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "dispute:create");
    const tenantId = principal.tenantId;
    const body = request.body as any;
    if (!body?.clientDisputeId || String(body.clientDisputeId).trim() === "") {
      return reply.code(400).send(badRequest(request, "clientDisputeId required"));
    }
    if (!body?.reason || String(body.reason).trim() === "") {
      return reply.code(400).send(badRequest(request, "reason required"));
    }
    if (!body?.description || String(body.description).trim() === "") {
      return reply.code(400).send(badRequest(request, "description required"));
    }

    let assetId = body.assetId;
    if ((!assetId || String(assetId).trim() === "") && body.reference && String(body.reference).startsWith("QR:")) {
      try {
        const token = String(body.reference).slice(3);
        const verified = await services.asset.verifyQrToken(token);
        assetId = verified.asset.id;
      } catch (error) {
        if (error instanceof InvalidQrTokenError || error instanceof AssetNotFoundError) {
          return reply.code(404).send(notFound(request));
        }
        throw error;
      }
    }
    if (!assetId || String(assetId).trim() === "") {
      return reply.code(400).send(badRequest(request, "assetId or reference required"));
    }

    const config = await loadConfig(tenantId);
    const businessDate = todayInTimeZone(config?.locale.timezone ?? "UTC", new Date());
    const occurredAt = new Date(body.occurredAt);
    if (Number.isNaN(occurredAt.getTime())) return reply.code(400).send(badRequest(request, "Invalid occurredAt"));

    const dispute = await withTenant(db, tenantId, async (tx: any) => {
      const created = await repositories(tx).disputes.createIfAbsent({
        tenantId,
        assetId,
        openedByUserId: (principal as any).userId ?? (principal as any).id,
        zoneId: (principal as any).zoneId ?? null,
        clientDisputeId: body.clientDisputeId,
        reason: body.reason,
        description: body.description,
        occurredAt,
        businessDate,
        latitude: body.latitude ?? null,
        longitude: body.longitude ?? null,
      });
      if (created !== undefined && body.evidence !== undefined) {
        const { randomUUID } = await import("node:crypto");
        const key = `disputes/${tenantId}/${created.id}/${randomUUID()}.jpg`;
        const objectStorage = (services.asset as any).objectStorage;
        if (objectStorage?.putObject !== undefined) {
          await objectStorage.putObject(key, Buffer.from(body.evidence.contentBase64, "base64"), {
            contentType: body.evidence.contentType,
          });
        }
        await repositories(tx).disputes.attachEvidence({
          tenantId,
          disputeId: created.id,
          objectKey: key,
          contentType: body.evidence.contentType,
        });
      }
      return created;
    });

    if (dispute === undefined) {
      const existing = await withTenant(db, tenantId, async (tx: any) => repositories(tx).disputes.list(tenantId, {}));
      const found = (existing.rows as any[]).find((r: any) => r.clientDisputeId === body.clientDisputeId);
      return reply.send({ disputeId: found?.id, status: found?.status ?? "open" });
    }
    return reply.send({ disputeId: dispute.id, status: dispute.status });
    })();
  });

  (app as any).get("/v1/disputes", { schema: listDisputesSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "dispute:create");
    const tenantId = principal.tenantId;
    const query = request.query as any;
    const limit = query.limit !== undefined ? Number(query.limit) : undefined;
    const listArgs: any = {
      openedByUserId: (principal as any).userId ?? (principal as any).id,
      cursor: query.cursor,
      limit: Number.isFinite(limit as number) ? (limit as number) : undefined,
    };
    if (query.status !== undefined) listArgs.status = query.status;
    const result = await withTenant(db, tenantId, async (tx: any) => repositories(tx).disputes.list(tenantId, listArgs));
    return reply.send(result);
    })();
  });

  (app as any).get("/v1/disputes/:id", { schema: getDisputeSchema as any }, function (request: any, reply: any) {
    return (async () => {
    const principal = (requirePermission as any)(request, "dispute:create");
    const tenantId = principal.tenantId;
    const { id } = request.params as any;
    const dispute = await withTenant(db, tenantId, async (tx: any) => repositories(tx).disputes.find(tenantId, id));
    if (dispute === undefined) return reply.code(404).send({ error: { code: "not_found", message: "Dispute not found", requestId: String(request.id) } });
    return reply.send({ dispute });
    })();
  });
}
