{
  "name": "@tpirs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tpirs/adapters-otel-telemetry": "workspace:*",
    "@tpirs/domain": "workspace:*",
    "@tpirs/ports": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
