{
  "name": "@tpirs/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs && openapi-typescript openapi.json -o src/schema.gen.ts",
    "build": "pnpm run generate && tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tpirs/api": "workspace:*",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@tpirs/identity-provider-mock": "workspace:*",
    "@tpirs/telemetry-mock": "workspace:*",
    "openapi-typescript": "^7.5.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
